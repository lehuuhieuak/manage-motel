# Base path (or absolute URL) of the API Gateway used by the browser. Default: /api/v1
VITE_API_BASE_URL=/api/v1

# Local-development proxy target for /api requests (YARP API Gateway).
# Must match the gateway endpoint declared in ManageMotel.AppHost.
VITE_DEV_PROXY_TARGET=http://localhost:5241

# Dev server port used when Aspire does not inject PORT. Default: 5173
VITE_DEV_SERVER_PORT=5173
