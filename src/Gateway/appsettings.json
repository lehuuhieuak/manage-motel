{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identities-route": {
        "ClusterId": "identities-cluster",
        "Match": {
          "Path": "/api/v1/identities/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/identities"
          }
        ]
      },
      "billings-route": {
        "ClusterId": "billings-cluster",
        "Match": {
          "Path": "/api/v1/billings/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/billings"
          }
        ]
      },
      "rentals-route": {
        "ClusterId": "rentals-cluster",
        "Match": {
          "Path": "/api/v1/rentals/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/rentals"
          }
        ]
      },
      "meterings-route": {
        "ClusterId": "meterings-cluster",
        "Match": {
          "Path": "/api/v1/meterings/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/meterings"
          }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/payments"
          }
        ]
      }
    },
    "Clusters": {
      "identities-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "identities-api": {
            "Address": "http://localhost:8001/api/v1/"
          }
        }
      },
      "billings-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "billings-api": {
            "Address": "http://localhost:8002/api/v1/"
          }
        }
      },
      "rentals-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "rentals-api": {
            "Address": "http://localhost:8003/api/v1/"
          }
        }
      },
      "meterings-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "meterings-api": {
            "Address": "http://localhost:8004/api/v1/"
          }
        }
      },
      "payments-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "payments-api": {
            "Address": "http://localhost:8005/api/v1/"
          }
        }
      }
    }
  }
}
